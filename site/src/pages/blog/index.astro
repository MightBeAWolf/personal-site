---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPostCard from "../../components/BlogPostCard.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Blog" description="Posts on software, infrastructure, and AI engineering.">
  <article class="page">
    <header class="page-head">
      <div class="wrap col page-head__inner">
        <a class="page-back" href="/">&larr; Home</a>
        <h1>Blog</h1>
        <p class="lede">Posts on software, infrastructure, and AI engineering.</p>
      </div>
    </header>

    <section class="section">
      <div class="wrap col">
        <ul class="post-list">
          {posts.map((post) => <li><BlogPostCard entry={post} /></li>)}
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .col {
    max-width: 42rem;
  }

  .page-head__inner {
    padding-block: clamp(2rem, 6vw, 4rem) 0;
  }

  .page-back {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .page-back:hover {
    color: var(--accent);
    text-decoration: none;
  }

  h1 {
    font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.4rem);
    margin: 0.6em 0 0.3em;
  }

  .lede {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
    max-width: 55ch;
  }

  .section {
    padding-block: clamp(1rem, 4vw, 2rem) clamp(2.5rem, 6vw, 4rem);
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
</style>
