---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import GlossaryPopup from "../components/GlossaryPopup.astro";
import { linkGlossaryTerms } from "../lib/glossary-link";
import { stackCategories } from "../data/tech-stack";

const updated = "September 2026";

const glossaryEntries = await getCollection("glossary");
const glossaryTerms = glossaryEntries.map((e) => ({
  id: e.id,
  title: e.data.title,
  aliases: e.data.aliases,
}));
const glossary = (d: string) => linkGlossaryTerms(d, glossaryTerms);
const glossaryById = new Map(glossaryEntries.map((e) => [e.id, e]));

const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

const practiceEntries = await getCollection("practices");
const practices = await Promise.all(
  practiceEntries.map(async (e) => ({ ...e, rendered: await render(e) })),
);
const bySection = (section: "tools" | "workflows") =>
  practices
    .filter((p) => p.data.section === section)
    .sort((a, b) => a.data.order - b.data.order);
const tools = bySection("tools");
const workflows = bySection("workflows");
---

<BaseLayout
  title="Tools, Workflows, and My Tech Stack"
  description="The editor, workflows, and technologies Thomas G. Wolf builds and operates with — from Helix and mise to Kubernetes, GitOps, and RAG pipelines."
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Monoton&display=swap"
    />
  </Fragment>
  <article class="page">
    <header class="page-head">
      <div class="wrap page-head__inner">
        <a class="page-back" href="/">&larr; Home</a>
        <p class="page-updated">Updated {updated}</p>
        <h1>Tools, Workflows, and My Tech Stack</h1>
        <p class="lede">
          How I actually work: the tools on my machine, the workflows I lean
          on, and the technologies I reach for when building and operating
          systems. I run most of this as a single operator, so it is all
          biased toward reproducibility, automation, and keeping the blast
          radius small.
        </p>
      </div>
    </header>

    <section class="section">
      <div class="wrap">
        <div class="tri-grid">
          <h2 class="tri-label" style={`grid-row: span ${tools.length}`}>
            Tools
          </h2>
          {
            tools.map((t) => {
              const { Content } = t.rendered;
              return (
                <>
                  <div class="tri-item">
                    <h3>{t.data.title}</h3>
                    <p set:html={glossary(t.data.teaser)} />
                  </div>
                  <details class="accordion-item" name="tools-accordion">
                    <summary>
                      <span>Details</span>
                      <span class="chevron" aria-hidden="true">
                        &rsaquo;
                      </span>
                    </summary>
                    <div class="accordion-body glossary-body">
                      <Content />
                    </div>
                  </details>
                </>
              );
            })
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="tri-grid">
          <h2 class="tri-label" style={`grid-row: span ${workflows.length}`}>
            Workflows
          </h2>
          {
            workflows.map((w) => {
              const { Content } = w.rendered;
              return (
                <>
                  <div class="tri-item">
                    <h3>{w.data.title}</h3>
                    <p set:html={glossary(w.data.teaser)} />
                  </div>
                  <details class="accordion-item" name="workflows-accordion">
                    <summary>
                      <span>Details</span>
                      <span class="chevron" aria-hidden="true">
                        &rsaquo;
                      </span>
                    </summary>
                    <div class="accordion-body glossary-body">
                      <Content />
                    </div>
                  </details>
                </>
              );
            })
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="tri-grid">
          <h2
            class="tri-label"
            style={`grid-row: span ${stackCategories.length}`}
          >
            Tech stack
          </h2>
          {
            stackCategories.map((cat) => (
              <>
                <div class="tri-item">
                  <h3>{cat.label}</h3>
                  <p>{cat.description}</p>
                </div>
                <div class="accordion-nested">
                  {cat.groups.map((group) => (
                    <details
                      class="accordion-item accordion-item--group"
                      name={`stack-groups-${slugify(cat.label)}`}
                    >
                      <summary>
                        <span>{group.label}</span>
                        <span class="chevron" aria-hidden="true">
                          &rsaquo;
                        </span>
                      </summary>
                      <div class="accordion-body">
                        {group.items.map((item) => {
                          const entry = item.glossaryId
                            ? glossaryById.get(item.glossaryId)
                            : undefined;
                          return entry ? (
                            <details
                              class="accordion-item accordion-item--leaf"
                              name={`stack-leaves-${slugify(cat.label)}-${slugify(group.label)}`}
                            >
                              <summary>
                                <span>{item.label}</span>
                                <span class="chevron" aria-hidden="true">
                                  &rsaquo;
                                </span>
                              </summary>
                              <div class="accordion-body glossary-body">
                                <p>{entry.data.summary}</p>
                                <a href={`/glossary/${entry.id}/`}>
                                  Open full page &rarr;
                                </a>
                              </div>
                            </details>
                          ) : (
                            <div class="stack-leaf-plain">{item.label}</div>
                          );
                        })}
                      </div>
                    </details>
                  ))}
                </div>
              </>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section--colophon">
      <div class="wrap">
        <h2 class="section__title">Colophon</h2>
        <p>
          This site is a static <a href="https://astro.build">Astro</a> build, served
          as a container in development or via nginx in production, all driven by
          mise tasks. The editor config wires <a href="https://github.com/withastro/language-tools"><code>astro-ls</code></a> into Helix, and the theme
          system is generated from the <a href="https://github.com/helix-editor/helix">Helix</a> project's bundled themes.
        </p>
      </div>
    </section>

    <GlossaryPopup terms={glossaryTerms} />
  </article>
</BaseLayout>

<style>
  .page-head__inner {
    padding-block: clamp(2rem, 6vw, 4rem) 0;
    max-width: 50rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .page-back {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .page-back:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .page-updated {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  h1 {
    flex-basis: 100%;
    font-size: clamp(2rem, 1.6rem + 2vw, 2.75rem);
    margin: 0.6em 0 0.35em;
  }

  .lede {
    flex-basis: 100%;
    font-size: 1.1rem;
    color: var(--text-muted);
    margin: 0;
    max-width: 60ch;
  }

  .section {
    padding-block: clamp(1.5rem, 5vw, 3rem);
  }

  .section + .section {
    border-top: 1px solid var(--border);
  }

  .section__title {
    font-size: 1.05rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin: 0 0 1.5rem;
  }

  /* three-column grid: category | sub-item | accordion detail */
  .tri-grid {
    display: grid;
    grid-template-columns: 10% 20% 1fr;
    column-gap: 1.5rem;
    row-gap: 1rem;
    align-items: start;
  }

  .tri-label {
    grid-column: 1;
    /* Vertical instead of horizontal text sidesteps an earlier overflow
       problem entirely - the word's length runs down the block axis
       (plenty of room, the box spans the whole section) instead of across
       the narrow 10% column. text-orientation: upright keeps each
       character in its normal orientation (not rotated sideways),
       stacked one per line going down the column. letter-spacing (not
       line-height, which instead controls the inline (here, horizontal)
       box the text sits in) is what closes up the gap between stacked
       characters; -0.5em is a first guess at "~80% tighter", worth
       eyeballing. */
    writing-mode: vertical-rl;
    text-orientation: upright;
    letter-spacing: -0.5em;
    /* Flush against the site header (its rendered height: 4rem
       min-height + 1px border-bottom), not floating a gap below it - the
       old 5.5rem offset left a ~1.5rem strip between the header and the
       label's own background where content scrolling up underneath was
       briefly visible again before the label caught up. The breathing
       room that gap used to provide now lives inside the box instead, as
       padding-top, so the label's (opaque) background covers the full
       run from the header down with nothing showing through. */
    position: sticky;
    top: calc(4rem + 1px);
    padding-top: 1.5rem;
    /* stretch (not height: 100%) fills the spanned grid area - percentage
       heights on a grid item can create a sizing feedback loop against
       auto-sized rows (the row heights depend on the item's height, which
       depends on the row heights...), which was inflating each section's
       row heights far beyond their actual content and shoving Tools/
       Workflows' rows down near the Tech stack section. stretch is
       resolved after track sizing is finalized, so it doesn't. */
    align-self: stretch;
    margin: 0;
    padding-right: 0.75rem;
    border-right: 1px solid var(--border);
    /* An opaque fill so the sticky label reads cleanly against whatever
       scrolls underneath it - most visible on the mobile stacked layout,
       where it's pinned directly over the item/accordion text rather
       than sitting beside it in its own column. z-index is a belt-and-
       braces addition: sticky already paints above in-flow siblings by
       default, but this makes the intent explicit. */
    background: var(--bg);
    z-index: 1;
    font-family: "Monoton", system-ui, sans-serif;
    font-weight: 400;
    font-size: 72px;
    line-height: 1;
    color: var(--heading);
  }

  .tri-item {
    grid-column: 2;
  }

  .tri-item h3 {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    color: var(--heading);
  }

  .tri-item p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .tri-item p :global(a) {
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--link) 45%, transparent);
  }

  .tri-item p :global(a:hover) {
    color: var(--link-hover);
  }

  .tri-item p :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--bg-inset);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1em 0.35em;
    color: var(--code-text);
  }

  /* Bootstrap-style accordion: boxed, full-width button header, rotating
     chevron - rather than a bare text row with a small arrow. */
  summary {
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .accordion-item,
  .stack-leaf-plain {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    overflow: hidden;
  }

  .accordion-item {
    grid-column: 3;
  }

  .accordion-nested {
    grid-column: 3;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .accordion-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    font-weight: 600;
    color: var(--heading);
  }

  .accordion-item[open] > summary {
    background: color-mix(in srgb, var(--accent) 12%, var(--bg-raised));
    border-bottom: 1px solid var(--border);
  }

  .chevron {
    flex: 0 0 auto;
    color: var(--text-faint);
    transition: transform 0.15s ease;
  }

  details[open] > summary > .chevron {
    transform: rotate(90deg);
  }

  .accordion-body {
    padding: 0.9rem 1rem;
  }

  /* nested (Group -> Leaf) tier reads as a sub-level: muted, smaller */
  .accordion-item--group > .accordion-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem;
    background: var(--bg-inset);
  }

  .accordion-item--leaf {
    background: var(--bg);
  }

  .accordion-item--leaf summary {
    padding: 0.6rem 0.85rem;
    font-weight: 500;
    font-size: 0.92rem;
  }

  .accordion-item--leaf .accordion-body {
    padding: 0 0.85rem 0.75rem;
    font-size: 0.9rem;
  }

  .accordion-item--leaf .accordion-body p {
    margin: 0 0 0.5em;
  }

  .stack-leaf-plain {
    padding: 0.6rem 0.85rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .section--colophon p {
    max-width: 60ch;
    color: var(--text-muted);
  }

  .section--colophon a {
    color: var(--link);
  }

  .section--colophon a:hover {
    color: var(--link-hover);
  }

  .section--colophon code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--code-text);
  }

  @media (max-width: 48rem) {
    /* display: flex (not just a 1-column grid-template-columns) is the
       point here: .tri-item/.accordion-item/.accordion-nested all carry
       an explicit grid-column, and .tri-label an explicit grid-row span
       (inline style, so a class rule can't override it without
       !important). Left in a grid, those placements force the browser to
       implicitly generate extra column tracks to satisfy them regardless
       of grid-template-columns, silently recreating a multi-column
       layout - which is what was overflowing at narrow widths. Dropping
       `display: grid` makes every grid-column/grid-row placement inert,
       so children just stack in DOM order instead. */
    .tri-grid {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    /* Vertical text only makes sense once there are side-by-side columns
       to run alongside - stacked full-width, it just reads as an oddly
       narrow, oddly cropped heading. Back to normal horizontal text,
       sized down from 72px to a regular heading size, with a bottom rule
       taking over from the vertical divider (which had nothing left to
       divide). position: sticky carries over unchanged from the base
       rule - it still works as a plain "stays put while its section
       scrolls by" heading once the container is a flex column instead of
       a grid; sticky doesn't care which layout mode its parent uses. */
    .tri-label {
      writing-mode: horizontal-tb;
      text-orientation: mixed;
      letter-spacing: normal;
      font-size: 1.75rem;
      line-height: 1.2;
      padding-right: 0;
      padding-bottom: 0.5rem;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }
  }
</style>
