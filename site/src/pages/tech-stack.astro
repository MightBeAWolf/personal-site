---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import GlossaryPopup from "../components/GlossaryPopup.astro";
import { linkGlossaryTerms } from "../lib/glossary-link";

const updated = "September 2026";

const glossaryEntries = await getCollection("glossary");
const glossaryTerms = glossaryEntries.map((e) => ({
  id: e.id,
  title: e.data.title,
  aliases: e.data.aliases,
}));
const glossary = (d: string) => linkGlossaryTerms(d, glossaryTerms);

const tools = [
  {
    k: "Editor",
    d: "Helix. Modal, no plugin system, LSP and tree-sitter built in. The theme picker on this site is generated from every one of its bundled themes.",
  },
  {
    k: "Runtime & tasks",
    d: "mise to pin language and tool versions per project and to drive per-repo task runners and environment.",
  },
  {
    k: "Containers",
    d: "Podman, rootless and daemonless.",
  },
  {
    k: "AI pair",
    d: "Claude Code and OpenCode for day-to-day engineering; purpose-built agent harnesses where a workflow needs one.",
  },
  {
    k: "Secrets",
    d: "1Password as the source of truth, injected into environments at runtime (via <code>fnox</code> + <code>age</code> here) and never committed.",
  },
  {
    k: "Shell & OS",
    d: "bash and Linux everywhere, a laptop managed the same way as a node in a cluster.",
  },
].map((t) => ({ ...t, d: glossary(t.d) }));

const workflows = [
  {
    k: "Infrastructure as code",
    d: "Ansible for configuration, Terraform / OpenTofu for provisioning, Packer and cloud-init for images. If it is not in a repo, it is not real.",
  },
  {
    k: "GitOps",
    d: "Argo CD reconciles cluster state from Git; CI/CD runs in Gitea Actions on a self-hosted forge.",
  },
  {
    k: "Reproducible builds",
    d: "Projects declare their toolchain and build in containers, so a checkout is enough to build and run. This site is a small example: one <code>mise run start</code> renders a Containerfile and serves the app.",
  },
  {
    k: "Observability first",
    d: "Grafana, Loki, and Prometheus (with Grafana Alloy) go in early, not after something breaks; Gatus and ntfy cover health and alerting.",
  },
  {
    k: "Compliance as a constraint",
    d: "NIST 800-171 / CMMC 2.0 requirements shape the architecture from the start rather than being bolted on.",
  },
].map((w) => ({ ...w, d: glossary(w.d) }));

const stack = [
  {
    k: "AI infrastructure",
    d: "RAG pipelines, autonomous agents, agent sandboxing, MCP tool integration, Claude Code, OpenCode, Hermes Agent, containerized job orchestration, Open WebUI",
  },
  {
    k: "Application & solution architecture",
    d: "API design, service decomposition, integration patterns, monolith-to-modular modernization, workflow-oriented applications, system design for scale, design review and architecture standards",
  },
  { k: "Languages", d: "Python, TypeScript, Bash, C, C++, C#, Rust, Java, Lisp, TCL" },
  {
    k: "Cloud & platform",
    d: "AWS, Azure, Hetzner Cloud, Proxmox, QEMU, Kubernetes and K3s (including greenfield buildouts), Helm, Docker, Podman, Traefik, Apache Guacamole, Bind9, Cloudflare, systemd",
  },
  {
    k: "Automation & IaC",
    d: "Ansible, Ansible Molecule, Terraform / OpenTofu, Packer, cloud-init, mise, Argo CD, Gitea Actions, Playwright",
  },
  {
    k: "Observability",
    d: "Grafana, Loki, Graylog, Prometheus, Grafana Alloy, InfluxDB, Gatus, ntfy",
  },
  {
    k: "Identity, endpoint & PKI",
    d: "Active Directory, Microsoft Intune, Authentik SSO with enforced MFA and forward-auth, OpenLDAP, SSSD, step-ca private CA, cert-manager, Certbot / Let's Encrypt, 1Password",
  },
  {
    k: "Data & storage",
    d: "PostgreSQL, CloudNativePG, Redis, SeaweedFS, Gitea, n8n",
  },
  {
    k: "Security & compliance",
    d: "NIST 800-171, CMMC 2.0 (Levels 2–3), Kubernetes hardening (Pod Security Admission, audit policy, etcd encryption at rest), fail2ban, firewalld / UFW, WireGuard",
  },
  { k: "Delivery & collaboration", d: "Jira, Confluence, Slack, Teams" },
].map((s) => ({ ...s, d: glossary(s.d) }));
---

<BaseLayout
  title="Tools, Workflows, and My Tech Stack"
  description="The editor, workflows, and technologies Thomas G. Wolf builds and operates with — from Helix and mise to Kubernetes, GitOps, and RAG pipelines."
>
  <article class="page">
    <header class="page-head">
      <div class="wrap page-head__inner">
        <a class="page-back" href="/">&larr; Home</a>
        <p class="page-updated">Updated {updated}</p>
        <h1>Tools, Workflows, and My Tech Stack</h1>
        <p class="lede">
          How I actually work: the tools on my machine, the workflows I lean
          on, and the technologies I reach for when building and operating
          systems. I run most of this as a single operator, so it is all
          biased toward reproducibility, automation, and keeping the blast
          radius small.
        </p>
      </div>
    </header>

    <section class="section">
      <div class="wrap">
        <h2 class="section__title">Tools</h2>
        <ul class="cards">
          {
            tools.map((t) => (
              <li class="card">
                <h3 class="card__title">{t.k}</h3>
                <p class="card__body" set:html={t.d} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2 class="section__title">Workflows</h2>
        <ul class="cards">
          {
            workflows.map((w) => (
              <li class="card">
                <h3 class="card__title">{w.k}</h3>
                <p class="card__body" set:html={w.d} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2 class="section__title">Tech stack</h2>
        <dl class="stack">
          {
            stack.map((s) => (
              <>
                <dt>{s.k}</dt>
                <dd set:html={s.d} />
              </>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section section--colophon">
      <div class="wrap">
        <h2 class="section__title">Colophon</h2>
        <p>
          This site is a static <a href="https://astro.build">Astro</a> build, served
          as a container in development or via nginx in production, all driven by
          mise tasks. The editor config wires <a href="https://github.com/withastro/language-tools"><code>astro-ls</code></a> into Helix, and the theme
          system is generated from the <a href="https://github.com/helix-editor/helix">Helix</a> project's bundled themes.
        </p>
      </div>
    </section>

    <GlossaryPopup terms={glossaryTerms} />
  </article>
</BaseLayout>

<style>
  .page-head__inner {
    padding-block: clamp(2rem, 6vw, 4rem) 0;
    max-width: 50rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .page-back {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .page-back:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .page-updated {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  h1 {
    flex-basis: 100%;
    font-size: clamp(2rem, 1.6rem + 2vw, 2.75rem);
    margin: 0.6em 0 0.35em;
  }

  .lede {
    flex-basis: 100%;
    font-size: 1.1rem;
    color: var(--text-muted);
    margin: 0;
    max-width: 60ch;
  }

  .section {
    padding-block: clamp(1.5rem, 5vw, 3rem);
  }

  .section__title {
    font-size: 1.05rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin: 0 0 1.5rem;
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem;
    background: var(--bg-raised);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .card__title {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    color: var(--heading);
  }

  .card__body {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .card__body :global(a) {
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--link) 45%, transparent);
  }

  .card__body :global(a:hover) {
    color: var(--link-hover);
  }

  .card__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--bg-inset);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1em 0.35em;
    color: var(--code-text);
  }

  .stack {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(11rem, 16rem) 1fr;
    gap: 0.9rem 1.5rem;
  }

  .stack dt {
    font-weight: 600;
    color: var(--heading);
  }

  .stack dd {
    margin: 0;
    color: var(--text-muted);
  }

  .section--colophon {
    border-top: 1px solid var(--border);
  }

  .section--colophon p {
    max-width: 60ch;
    color: var(--text-muted);
  }

  .section--colophon a {
    color: var(--link);
  }

  .section--colophon a:hover {
    color: var(--link-hover);
  }

  .section--colophon code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--code-text);
  }

  @media (max-width: 40rem) {
    .stack {
      grid-template-columns: 1fr;
      gap: 0.2rem 0;
    }

    .stack dd {
      margin-bottom: 1.1rem;
    }
  }
</style>
